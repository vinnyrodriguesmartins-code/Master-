# =====================================================================
# Variáveis de ambiente do projeto — copie para .env e preencha.
# Todas são lidas em um único lugar: config.js
# =====================================================================

# ---------- Execução de testes ----------
# android | ios
TEST_PLATFORM=android
# Caminho do Android SDK (necessário para iniciar o emulador automaticamente)
# ANDROID_HOME=C:\Users\SEU_USUARIO\AppData\Local\Android\Sdk

# ---------- BrowserStack (execução na nuvem) ----------
BROWSERSTACK=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_APP_ID=

# ---------- IA / RAG (Google Gemini) ----------
GEMINI_API_KEY=sua_chave_aqui
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# false desativa o diagnóstico automático após cada execução do wdio
AI_MONITOR=true

# ---------- GitLab (somente CI — comentário no Merge Request) ----------
# Token com escopo "api". As variáveis CI_* são fornecidas automaticamente pelo GitLab.
# GITLAB_TOKEN=

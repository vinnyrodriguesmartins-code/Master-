        {
          "name": "11a - POST /usuarios (Criar usuário para Login)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueId = Math.floor(Math.random() * 1000000) + Date.now().toString().slice(-6);",
                  "const name = `Login User ${uniqueId}`;",
                  "const email = `login.user.${uniqueId}@teste.com`;",
                  "const password = `LoginPassword_${uniqueId}`;",
                  "",
                  "pm.collectionVariables.set(\"loginName\", name);",
                  "pm.collectionVariables.set(\"loginEmail\", email);",
                  "pm.collectionVariables.set(\"loginPassword\", password);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Save created login user ID\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.collectionVariables.set(\"loginUserId\", responseJson._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{loginName}}\",\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\",\n  \"administrador\": \"false\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }

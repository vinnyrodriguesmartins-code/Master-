              "listen": "prerequest",
              "script": {
                "exec": [
                  "const fakeId = \"id_nao_cadastrado_pm_\" + Math.floor(Math.random() * 100000);",
                  "pm.collectionVariables.set(\"nonexistentPutId\", fakeId);",
                  "",
                  "const uniqueId = Math.floor(Math.random() * 1000000);",
                  "pm.collectionVariables.set(\"putNewEmail\", \"put.new.user.\" + uniqueId + \"@teste.com\");"
                ],
                "type": "text/javascript"
              }

      "item": [
        {
          "name": "01 - POST /usuarios (Sucesso)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueId = Math.floor(Math.random() * 1000000) + Date.now().toString().slice(-6);",
                  "const name = `Usuário Carrefour ${uniqueId}`;",
                  "const email = `carrefour.user.${uniqueId}@teste.com`;",
                  "const password = `SecurePass_${uniqueId}`;",
                  "",
                  "pm.collectionVariables.set(\"dynamicName\", name);",
                  "pm.collectionVariables.set(\"dynamicEmail\", email);",
                  "pm.collectionVariables.set(\"dynamicPassword\", password);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Validate success message and store ID\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.message).to.eql(\"Cadastro realizado com sucesso\");",
                  "    pm.expect(responseJson._id).to.exist;",
                  "    pm.collectionVariables.set(\"createdUserId\", responseJson._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{dynamicName}}\",\n  \"email\": \"{{dynamicEmail}}\",\n  \"password\": \"{{dynamicPassword}}\",\n  \"administrador\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        },

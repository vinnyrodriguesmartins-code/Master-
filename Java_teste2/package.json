{
  "name": "desafio-automacao-api",
  "version": "1.0.0",
  "description": "Desafio de Automação de Testes de API - Carrefour Banco",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha test/specs/**/*.spec.js --reporter allure-mocha --timeout 15000",
    "test:postman": "newman run postman/ServeRest_API_Tests.postman_collection.json -e postman/ServeRest_Environment.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export postman/newman-report.xml --reporter-htmlextra-export postman/newman-report.html",
    "report:generate": "allure generate allure-results --clean",
    "report:open": "allure open",
    "report:clear": "rimraf allure-results allure-report"
  },
  "keywords": [
    "api",
    "testing",
    "supertest",
    "mocha",
    "chai",
    "allure"
  ],
  "author": "Paula Santiago",
  "license": "ISC",
  "devDependencies": {
    "allure-commandline": "^2.30.0",
    "allure-mocha": "^3.0.0",
    "chai": "^5.1.1",
    "mocha": "^10.7.0",
    "newman": "^6.1.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0"
  }
}
